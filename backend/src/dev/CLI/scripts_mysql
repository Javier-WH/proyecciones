#cantidad de estudiantes regulares/TSU por sexo y programa
SELECT inscripcions.* FROM `inscripcions` JOIN alumnos ON (alumnos.id = inscripcions.alumno_id) WHERE
inscripcions.programa_id = 18 AND
inscripcions.lapso_id = 171 AND
alumnos.sexo_id = 1
