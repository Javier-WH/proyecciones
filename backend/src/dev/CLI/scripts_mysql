#para saber por trayecto:
SELECT inscripcions.* FROM `inscripcions` JOIN alumnos ON (alumnos.id = inscripcions.alumno_id) JOIN otros_datos_alumnos ON (otros_datos_alumnos.alumno_id = inscripcions.alumno_id) WHERE
inscripcions.programa_id = 18 AND
inscripcions.lapso_id = 171 AND
otros_datos_alumnos.trayecto_id = 1 AND
alumnos.sexo_id = 2
